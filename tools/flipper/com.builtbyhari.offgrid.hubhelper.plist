<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. install-helper.sh fills in the __PLACEHOLDERS__ and copies it to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.builtbyhari.offgrid.hubhelper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HELPER__</string>
    <string>--pack</string>
    <string>__PACK__</string>
  </array>
  <!-- Runs each time any drive mounts. The script itself decides whether it is an Off-Grid hub. -->
  <key>StartOnMount</key><true/>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
</dict>
</plist>
